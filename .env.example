# Copie este arquivo para .env e preencha com sua chave:
#   cp .env.example .env
#
# O arquivo .env está no .gitignore e nunca vai para o Git.

# Chave do OpenCode Go (obrigatória para o agente responder)
OPENCODE_GO_API_KEY=

# Opcional: modelo do OpenCode Go
# OPENCODE_GO_MODEL=kimi-k2.5

# Opcional: porta do backend
# SORRIDENTE_PORT=8000
