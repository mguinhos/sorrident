# Copie este arquivo para .env e preencha com sua chave:
#   cp .env.example .env
#
# O arquivo .env está no .gitignore e nunca vai para o Git.

# Chave do OpenCode Go (obrigatória para o agente responder)
OPENCODE_GO_API_KEY=

# Opcional: modelo do OpenCode Go
# OPENCODE_GO_MODEL=kimi-k2.5

# Opcional: nível de raciocínio do agente (thinking)
# Valores: off, minimal, low, medium, high (padrão: low)
# Use "off" para desligar o raciocínio estendido.
# OPENCODE_GO_REASONING_EFFORT=low

# Opcional: porta do backend
# SORRIDENTE_PORT=8000

# ----------------------------------------------------------------
# E-mail transacional (confirmação e lembrete de agendamento)
# Deixe comentado se não for usar; o sistema segue funcionando sem e-mail.
# ----------------------------------------------------------------
# SORRIDENTE_SMTP_HOST=smtp.gmail.com
# SORRIDENTE_SMTP_PORT=587
# SORRIDENTE_SMTP_USER=seuemail@gmail.com
# SORRIDENTE_SMTP_PASSWORD=senha-de-app-do-gmail
# SORRIDENTE_SMTP_FROM=SorriDente <seuemail@gmail.com>
# SORRIDENTE_SMTP_STARTTLS=1
# SORRIDENTE_SMTP_SSL=0
