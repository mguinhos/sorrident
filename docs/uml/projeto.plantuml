@startuml SorriDente-Projeto
' Visão geral das camadas do SorriDente.
' Aqui não entram classes: a ideia é mostrar quem depende de quem.
' O detalhe de cada pacote está nos diagramas de src/.

!include src/_estilo.puml

title Visão geral do SorriDente

package "interface web" <<Node>> {
  [Next.js + Ant Design] as WEB
}

package "canais" {
  [Telegram] as TG
  [WhatsApp] as WA
  [Web] as CW
}

package "Groq Cloud" <<Cloud>> {
  [Modelo de linguagem] as LLM
}

package "api" {
  [FastAPI + rotas] as API
}

package "agent" {
  [SorriDenteAgent] as AGENTE
  [Ferramentas] as TOOLS
  [Contexto e tarefas] as CTX
}

package "rag" {
  [Base de conhecimento] as RAG
}

package "domain" {
  [Serviços] as SVC
  [Repositórios] as REPO
}

package "core" {
  [Contratos (ABC)] as CORE
  [Entidades] as ENT
}

package "integrations" {
  [Registro de integrações] as INTEG
}

package "infrastructure" {
  [TinyDB] as DB
  [credentials.json] as CRED
  [Barramento de eventos] as BUS
}

WEB --> API : HTTP/JSON
TG --> CW
WA --> CW
CW --> AGENTE : mensagem recebida
API --> SVC
API --> AGENTE

AGENTE --> TOOLS
AGENTE --> CTX
AGENTE --> LLM : inferência
TOOLS --> SVC
TOOLS --> RAG

SVC --> REPO
SVC --> CORE
REPO --> DB
RAG --> REPO

INTEG --> LLM
INTEG --> CRED
INTEG --> TG
INTEG --> WA

SVC ..> BUS : eventos
API ..> BUS : SSE

ENT <.. SVC
CORE <.. SVC
CORE <.. REPO

note bottom of CORE
  Só o core não depende de ninguém.
  As setas apontam sempre para dentro.
end note

@enduml
