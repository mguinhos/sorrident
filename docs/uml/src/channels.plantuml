@startuml channels
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam monospace true
hide empty members

package "core" {
  package "core.interfaces" {
    interface IAgent <<interface>> {
      + reply(context: 'AgentContext', user_message: str) -> str
    }
    interface IMessagingChannel <<interface>> {
      + channel_type() -> str
      + is_running() -> bool
      + start() -> None
      + stop() -> None
      + send(external_id: str, text: str) -> bool
      + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    }
  }
  package "core.models" {
    enum ChannelType <<enum>> {
      WEB
      TELEGRAM
      WHATSAPP
    }
    class Conversation {
    + channel: str
    + external_id: str
    + patient_id: str
    + display_name: str
    + last_message_at: str
    + unread_for_staff: int
    + handoff: bool
    + open: bool
    + closed_at: str
    + closed_reason: str
    + handoff_notice_at: str
    }
  }
  package "domain.services.interfaces" {
    interface IConversationService <<interface>> {
      + get_or_create(channel: str, external_id: str, display_name: str) -> Conversation
      + append(conversation_id: str, author: str, content: str) -> ChatMessage
      + history(conversation_id: str, limit: int) -> list[ChatMessage]
      + list_all(limit: int) -> list[Conversation]
      + mark_read(conversation_id: str) -> Conversation
      + set_handoff(conversation_id: str, handoff: bool) -> Conversation
      + get(conversation_id: str) -> Conversation
      + link_patient(conversation_id: str, patient_id: str) -> Conversation
      + mark_handoff_notice(conversation_id: str) -> Conversation
      + close(conversation_id: str, reason: str) -> Conversation
      + reopen(conversation_id: str) -> Conversation
      + idle_conversations(minutes: int) -> list[Conversation]
    }
    interface IPatientService <<interface>> {
      + create() -> Patient
      + update(patient_id: str) -> Patient
      + delete(patient_id: str) -> bool
      + get(patient_id: str) -> Patient
      + list_all(search: str) -> list[Patient]
      + get_or_create_by_channel(channel: str, external_id: str, name: str) -> Patient
    }
    interface ISettingsService <<interface>> {
      + get() -> ClinicSettings
      + update() -> ClinicSettings
    }
  }
}

package "channels" {
  class InboundMessage {
    - __init__(channel: str, external_id: str, text: str, display_name: str, metadata: Optional[dict[str, Any]]) -> None
  }
  interface IMessageDispatcher <<interface>> {
    + handle(inbound: InboundMessage) -> Optional[str]
  }
  class MessageDispatcher {
  + ESPERA: str
    - __init__(agent: IAgent, conversations: IConversationService, patients: IPatientService, settings: ISettingsService) -> None
    - _should_send_waiting_notice(conversation: Any) -> bool
    - _registration_summary(patient_id: str) -> str
    + handle(inbound: InboundMessage) -> Optional[str]
  }
  abstract class BaseChannel <<abstract>> {
    - __init__(dispatcher: MessageDispatcher) -> None
    + is_running() -> bool
    + channel_type() -> str
    + process(inbound: InboundMessage) -> Optional[str]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
  }
  class WebChannel {
    + channel_type() -> str
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
  }
  class TelegramChannel {
  + WELCOME: str
    - __init__(dispatcher: MessageDispatcher, token: str) -> None
    + channel_type() -> str
    + bot_username() -> str
    + last_error() -> str
    + set_token(token: str) -> None
    + status() -> dict[str, Any]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    - _poll_loop() -> None
    - _handle_update(update: dict[str, Any]) -> None
  }
  class TelegramClient {
    - __init__(token: str, timeout: float) -> None
    + close() -> None
    + call(method: str) -> dict[str, Any]
    + get_me() -> dict[str, Any]
    + get_updates(offset: int, timeout: int) -> list[dict[str, Any]]
    + send_message(chat_id: str, text: str) -> dict[str, Any]
    + send_document(chat_id: str, filename: str, data: bytes, content_type: str, caption: str) -> dict[str, Any]
    + send_chat_action(chat_id: str, action: str) -> None
  }
  class WhatsAppChannel {
    - __init__(dispatcher: MessageDispatcher, token: str, phone_number_id: str, verify_token: str) -> None
    + channel_type() -> str
    + verify_token() -> str
    + configure(token: str, phone_number_id: str, verify_token: str) -> None
    + status() -> dict[str, Any]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + handle_webhook(payload: dict[str, Any]) -> None
  }
  interface IChannelManager <<interface>> {
    + register(channel: IMessagingChannel) -> 'IChannelManager'
    + get(channel_type: str) -> IMessagingChannel
    + find(channel_type: str) -> Optional[IMessagingChannel]
    + send(channel_type: str, external_id: str, text: str) -> bool
    + send_document(channel_type: str, external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    + start(channel_type: str) -> None
    + stop(channel_type: str) -> None
    + stop_all() -> None
    + status() -> list[dict[str, Any]]
  }
  class ChannelManager {
    - __init__() -> None
    + register(channel: IMessagingChannel) -> 'ChannelManager'
    + get(channel_type: str) -> IMessagingChannel
    + find(channel_type: str) -> Optional[IMessagingChannel]
    + send(channel_type: str, external_id: str, text: str) -> bool
    + send_document(channel_type: str, external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    + start(channel_type: str) -> None
    + stop(channel_type: str) -> None
    + stop_all() -> None
    + status() -> list[dict[str, Any]]
    - __iter__() -> Iterator[IMessagingChannel]
  }

  IMessageDispatcher <|.. MessageDispatcher
  IMessagingChannel <|-- BaseChannel
  BaseChannel <|-- WebChannel
  BaseChannel <|-- TelegramChannel
  BaseChannel <|-- WhatsAppChannel
  IChannelManager <|.. ChannelManager
  ChannelManager o-- "0..*" IMessagingChannel : roteia por ChannelType
  MessageDispatcher o-- "1" IAgent
  MessageDispatcher o-- IConversationService
  MessageDispatcher o-- IPatientService
  MessageDispatcher o-- ISettingsService
  TelegramChannel o-- "1" TelegramClient
  InboundMessage ..> ChannelType
}
@enduml
