@startuml channels
!include _estilo.puml

package "core" {
  package "core.interfaces" {
    interface IAgent <<interface>>
    interface IMessagingChannel <<interface>>
  }
  package "core.models" {
    enum ChannelType <<enum>>
    class Conversation
  }
  package "domain.services.interfaces" {
    interface IConversationService <<interface>>
    interface IPatientService <<interface>>
    interface ISettingsService <<interface>>
  }
}

package "channels" {
  class InboundMessage {
  }
  interface IMessageDispatcher <<interface>> {
    + handle(inbound: InboundMessage) -> Optional[str]
  }
  class MessageDispatcher {
  + ESPERA: str
    - _should_send_waiting_notice(conversation: Any) -> bool
    - _registration_summary(patient_id: str) -> str
    + handle(inbound: InboundMessage) -> Optional[str]
  }
  abstract class BaseChannel <<abstract>> {
    + is_running() -> bool
    + channel_type() -> str
    + process(inbound: InboundMessage) -> Optional[str]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
  }
  class WebChannel {
    + channel_type() -> str
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
  }
  class TelegramChannel {
  + WELCOME: str
    + channel_type() -> str
    + bot_username() -> str
    + last_error() -> str
    + set_token(token: str) -> None
    + status() -> dict[str, Any]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    - _poll_loop() -> None
    - _handle_update(update: dict[str, Any]) -> None
  }
  class TelegramClient {
    + close() -> None
    + call(method: str) -> dict[str, Any]
    + get_me() -> dict[str, Any]
    + get_updates(offset: int, timeout: int) -> list[dict[str, Any]]
    + send_message(chat_id: str, text: str) -> dict[str, Any]
    + send_document(chat_id: str, filename: str, data: bytes, content_type: str, caption: str) -> dict[str, Any]
    + send_chat_action(chat_id: str, action: str) -> None
  }
  class WhatsAppChannel {
    + channel_type() -> str
    + verify_token() -> str
    + configure(token: str, phone_number_id: str, verify_token: str) -> None
    + status() -> dict[str, Any]
    + start() -> None
    + stop() -> None
    + send(external_id: str, text: str) -> bool
    + handle_webhook(payload: dict[str, Any]) -> None
  }
  interface IChannelManager <<interface>> {
    + register(channel: IMessagingChannel) -> 'IChannelManager'
    + get(channel_type: str) -> IMessagingChannel
    + find(channel_type: str) -> Optional[IMessagingChannel]
    + send(channel_type: str, external_id: str, text: str) -> bool
    + send_document(channel_type: str, external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    + start(channel_type: str) -> None
    + stop(channel_type: str) -> None
    + stop_all() -> None
    + status() -> list[dict[str, Any]]
  }
  class ChannelManager {
    + register(channel: IMessagingChannel) -> 'ChannelManager'
    + get(channel_type: str) -> IMessagingChannel
    + find(channel_type: str) -> Optional[IMessagingChannel]
    + send(channel_type: str, external_id: str, text: str) -> bool
    + send_document(channel_type: str, external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
    + start(channel_type: str) -> None
    + stop(channel_type: str) -> None
    + stop_all() -> None
    + status() -> list[dict[str, Any]]
    - __iter__() -> Iterator[IMessagingChannel]
  }

  IMessageDispatcher <|.. MessageDispatcher
  IMessagingChannel <|.. BaseChannel
  BaseChannel <|-- WebChannel
  BaseChannel <|-- TelegramChannel
  BaseChannel <|-- WhatsAppChannel
  IChannelManager <|.. ChannelManager
  ChannelManager o-- "0..*" IMessagingChannel : roteia por ChannelType
  MessageDispatcher o-- "1" IAgent
  MessageDispatcher o-- IConversationService
  MessageDispatcher o-- IPatientService
  MessageDispatcher o-- ISettingsService
  TelegramChannel o-- "1" TelegramClient
  InboundMessage ..> ChannelType
}
@enduml
