    + kind
      - __init__() -> None
      + register(integration: BaseInferenceIntegration) -> 'InferenceRegistry'
      + active_key() -> str
      + active_integration() -> Optional[BaseInferenceIntegration]
      + activate(key: str) -> BaseInferenceIntegration
    }
    class MessagingRegistry {
    + kind
      + start_enabled() -> None
      + stop_all() -> None
      + running() -> list[BaseChannelIntegration]
    }
    class IntegrationRegistry {
      - __init__(credentials: ICredentialStore) -> None
      + registries() -> tuple[BaseIntegrationRegistry[Any], ...]
      + register(integration: IIntegration) -> 'IntegrationRegistry'
      + get(key: str) -> IIntegration
      + all() -> list[IIntegration]
      + load_all() -> None
      + save(key: str, values: dict[str, Any]) -> IIntegration
      + enable(key: str) -> IIntegration
      + disable(key: str) -> IIntegration
      + set_active_inference(key: str) -> BaseInferenceIntegration
      + autostart() -> None
      + shutdown() -> None
      + describe_all() -> list[dict[str, Any]]
      - __iter__() -> Iterator[IIntegration]
      - __len__() -> int
    }
    IIntegration <|-- BaseIntegration
    BaseIntegration <|-- BaseInferenceIntegration
    BaseInferenceIntegration <|-- GroqInferenceIntegration
    BaseIntegration <|-- BaseChannelIntegration
    BaseChannelIntegration <|-- TelegramIntegration
    BaseChannelIntegration <|-- WhatsAppIntegration
    ILLMProvider <|.. RoutingLLMProvider
    RoutingLLMProvider ..> InferenceResolver
    InferenceResolver <|.. InferenceRegistry
    IntegrationRegistry *-- "0..*" InferenceRegistry
    IntegrationRegistry *-- "0..*" MessagingRegistry
    IntegrationRegistry o-- "1" ICredentialStore
    GroqInferenceIntegration o-- "1" GroqLLMProvider
    TelegramIntegration o-- "1" TelegramChannel
    WhatsAppIntegration o-- "1" WhatsAppChannel
}

package "export" {
    class ExportedFile {
    + filename: str
    + content_type: str
    + data: bytes
      + size_kb() -> int
    }
    interface IConversationExporter <<interface>> {
      + format() -> str
      + content_type() -> str
      + export(conversation: Conversation, messages: Sequence[ChatMessage], clinic_name: str) -> ExportedFile
    }
    interface IExportService <<interface>> {
      + formats() -> list[str]
      + export(conversation_id: str, export_format: str) -> ExportedFile
      + export_and_send(conversation_id: str, export_format: str) -> dict[str, object]
    }
    abstract class BaseExporter <<abstract>> {
    + VISIBLE_AUTHORS: tuple
      - _visible(messages: Sequence[ChatMessage]) -> list[ChatMessage]
      - _stamp(value: str) -> str
      - _author(message: ChatMessage) -> str
      - _basename(conversation: Conversation) -> str
    }
    class TextExporter {
      + format() -> str
      + content_type() -> str
      + export(conversation: Conversation, messages: Sequence[ChatMessage], clinic_name: str) -> ExportedFile
    }
    class MarkdownExporter {
      + format() -> str
      + content_type() -> str
      + export(conversation: Conversation, messages: Sequence[ChatMessage], clinic_name: str) -> ExportedFile
    }
    class HtmlExporter {
      + format() -> str
      + content_type() -> str
      + export(conversation: Conversation, messages: Sequence[ChatMessage], clinic_name: str) -> ExportedFile
    }
    class ConversationExportService {
      - __init__(conversations: IConversationService, settings: ISettingsService, channels: IChannelManager, exporters: Iterable[IConversationExporter]) -> None
      + formats() -> list[str]
      - _exporter(export_format: str) -> IConversationExporter
      + export(conversation_id: str, export_format: str) -> ExportedFile
      + export_and_send(conversation_id: str, export_format: str) -> dict[str, object]
    }
    IConversationExporter <|-- BaseExporter
    BaseExporter <|-- TextExporter
    BaseExporter <|-- MarkdownExporter
    BaseExporter <|-- HtmlExporter
    IExportService <|.. ConversationExportService
    ConversationExportService o-- "0..*" IConversationExporter
    ConversationExportService o-- "1" IConversationService
    ConversationExportService o-- "1" IChannelManager
    ConversationExportService o-- "1" ISettingsService
}

package "scheduler" {
    interface IBackgroundJob <<interface>> {
      + interval_seconds() -> int
      + job_name() -> str
      + run_once() -> None
    }
    interface IScheduler <<interface>> {
      + register(job: IBackgroundJob) -> 'IScheduler'
      + start() -> None
      + stop() -> None
      + jobs() -> Sequence[IBackgroundJob]
    }
    class AppointmentReminderJob {
      - __init__(appointments: IAppointmentService, patients: PatientRepository, channels: IChannelManager, notifications: INotificationService, interval_seconds: int, window_hours: int) -> None
      + interval_seconds() -> int
      + run_once() -> None
    }
    class ConversationTimeoutJob {
    + DESPEDIDA: str
      - __init__(conversations: IConversationService, channels: IChannelManager, settings: ISettingsService, interval_seconds: int) -> None
      + interval_seconds() -> int
      + run_once() -> None
    }
    class KnowledgeReindexJob {
      - __init__(knowledge: IKnowledgeService, interval_seconds: int) -> None
      + interval_seconds() -> int
      + run_once() -> None
    }
    class BackgroundScheduler {
      - __init__() -> None
      + jobs() -> Sequence[IBackgroundJob]
      + register(job: IBackgroundJob) -> 'BackgroundScheduler'
      + start() -> None
      + stop() -> None
      - _loop(job: IBackgroundJob) -> None
    }
    IBackgroundJob <|.. AppointmentReminderJob
    IBackgroundJob <|.. ConversationTimeoutJob
    IBackgroundJob <|.. KnowledgeReindexJob
    IScheduler <|.. BackgroundScheduler
    BackgroundScheduler o-- "0..*" IBackgroundJob
}

