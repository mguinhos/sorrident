@startuml SorriDente-Projeto
' ============================================================
' Diagrama UML mestre do backend SorriDente (Clean Architecture)
' Gerado a partir do inventário AST de backend/sorridente/
' Este arquivo é a fonte; os fragmentos em docs/uml/src/
' são extrações deste master, um por diagrama/render SVG.
' ============================================================
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam monospace true
hide empty members

package "core (domínio puro)" {
    package "core.models" {
        enum Role <<enum>> {
          CLIENTE
          GESTOR
          MEDICO
        }
        enum SlotType <<enum>> {
          REGULAR
          ENCAIXE
        }
        enum Priority <<enum>> {
          NORMAL
          URGENTE
        }
        enum AppointmentStatus <<enum>> {
          AGENDADO
          CONFIRMADO
          CONCLUIDO
          CANCELADO
          FALTOU
        }
        enum ChannelType <<enum>> {
          WEB
          TELEGRAM
          WHATSAPP
        }
        enum MessageAuthor <<enum>> {
          USER
          ASSISTANT
          SYSTEM
          TOOL
          HUMAN_AGENT
        }
        enum NotificationLevel <<enum>> {
          INFO
          SUCESSO
          ALERTA
          ERRO
        }

        class Entity {
        + id: str
        + created_at: str
        + updated_at: str
          + to_dict() -> dict[str, Any]
          + from_dict(data: dict[str, Any])
          + touch() -> None
        }
        class Patient {
        + name: str
        + phone: str
        + email: str
        + birth_date: str
        + document: str
        + insurance_provider: str
        + insurance_card: str
        + responsible_name: str
        + notes: str
        + telegram_id: str
        + whatsapp_id: str
        + treatment: str
        + active: bool
        }
        class Dentist {
        + name: str
        + cro: str
        + specialty: str
        + email: str
        + phone: str
        + color: str
        + active: bool
        + availability: dict[str, list[list[str]]]
        }
        class Procedure {
        + name: str
        + description: str
        + duration_minutes: int
        + price: float
        + active: bool
        }
        class Appointment {
        + patient_id: str
        + patient_name: str
        + dentist_id: str
        + dentist_name: str
        + procedure_id: str
        + procedure_name: str
        + start: str
        + end: str
        + status: str
        + slot_type: str
        + priority: str
        + notes: str
        + origin: str
        + reminder_sent: bool
          + is_encaixe() -> bool
          + is_urgent() -> bool
          + duration_minutes() -> int
          + start_dt() -> datetime
          + end_dt() -> datetime
        }
        class ChatMessage {
        + conversation_id: str
        + author: str
        + content: str
        + tool_name: str
        + tool_payload: dict[str, Any]
        }
        class Conversation {
        + channel: str
        + external_id: str
        + patient_id: str
        + display_name: str
        + last_message_at: str
        + unread_for_staff: int
        + handoff: bool
        + open: bool
        + closed_at: str
        + closed_reason: str
        + handoff_notice_at: str
        }
        class Notification {
        + title: str
        + message: str
        + level: str
        + read: bool
        + link: str
        + meta: dict[str, Any]
        }
        class FAQ {
        + question: str
        + answer: str
        + tags: list[str]
        + active: bool
        }
        class KnowledgeDocument {
        + title: str
        + content: str
        + source: str
        + source_id: str
        + tags: list[str]
        + active: bool
        }
        class ClinicSettings {
        + clinic_name: str
        + address: str
        + phone: str
        + email: str
        + opening_hour: str
        + closing_hour: str
        + lunch_start: str
        + lunch_end: str
        + working_days: list[int]
        + slot_minutes: int
        + inactivity_minutes: int
        + emergency_slot_minutes: int
        + max_emergency_per_day: int
        + handoff_notice_cooldown_minutes: int
        + persona: str
        }
        class User {
        + username: str
        + password_hash: str
        + role: str
        + display_name: str
        + linked_id: str
        + active: bool
        }

        Entity <|-- Patient
        Entity <|-- Dentist
        Entity <|-- Procedure
        Entity <|-- Appointment
        Entity <|-- ChatMessage
        Entity <|-- Conversation
        Entity <|-- Notification
        Entity <|-- FAQ
        Entity <|-- KnowledgeDocument
        Entity <|-- ClinicSettings
        Entity <|-- User
        Conversation "1" *-- "0..*" ChatMessage
        Patient "1" o-- "0..*" Appointment
        Dentist "1" o-- "0..*" Appointment
        Procedure "1" o-- "0..*" Appointment
        Appointment ..> AppointmentStatus
        Appointment ..> SlotType
        Appointment ..> Priority
        Appointment ..> ChannelType
        ChatMessage ..> MessageAuthor
        Conversation ..> ChannelType
        Notification ..> NotificationLevel
        User ..> Role
    }

    package "core.interfaces (contratos ABC)" {
        interface IDatabase <<interface>> {
          + connect() -> None
          + disconnect() -> None
          + insert(table: str, document: dict[str, Any]) -> dict[str, Any]
          + update(table: str, doc_id: str, document: dict[str, Any]) -> dict[str, Any]
          + delete(table: str, doc_id: str) -> bool
          + get(table: str, doc_id: str) -> Optional[dict[str, Any]]
          + find(table: str, filters: Optional[dict[str, Any]]) -> list[dict[str, Any]]
          + all(table: str) -> list[dict[str, Any]]
          + count(table: str, filters: Optional[dict[str, Any]]) -> int
        }
        interface IRepository <<interface>> {
          + table_name() -> str
          + add(entity: T) -> T
          + update(entity: T) -> T
          + remove(entity_id: str) -> bool
          + get(entity_id: str) -> Optional[T]
          + list(filters: Optional[dict[str, Any]]) -> list[T]
        }
        interface ICredentialStore <<interface>> {
          + get(key: str, default: Any) -> Any
          + set(key: str, value: Any) -> None
          + all() -> dict[str, Any]
          + delete(key: str) -> None
        }
        interface ILLMProvider <<interface>> {
          + model() -> str
          + complete(messages: Sequence[dict[str, Any]], tools: Optional[Sequence[dict[str, Any]]], temperature: float, max_tokens: int) -> dict[str, Any]
          + stream(messages: Sequence[dict[str, Any]], temperature: float, max_tokens: int) -> AsyncIterator[str]
        }
        interface ITool <<interface>> {
          + name() -> str
          + description() -> str
          + parameters() -> dict[str, Any]
          + execute(context: 'AgentContext') -> Any
          + to_schema() -> dict[str, Any]
        }
        interface IAgent <<interface>> {
          + reply(context: 'AgentContext', user_message: str) -> str
        }
        interface IMessagingChannel <<interface>> {
          + channel_type() -> str
          + is_running() -> bool
          + start() -> None
          + stop() -> None
          + send(external_id: str, text: str) -> bool
          + send_document(external_id: str, filename: str, data: bytes, content_type: str, caption: str) -> bool
        }
        interface IEventBus <<interface>> {
          + publish(event: str, payload: dict[str, Any]) -> None
          + subscribe() -> Any
          + unsubscribe(queue: Any) -> None
        }
        class AgentContext {
          - __init__(conversation_id: str, channel: str, external_id: str, patient_id: str, display_name: str, metadata: Optional[dict[str, Any]]) -> None
          + to_dict() -> dict[str, Any]
        }
    }

    package "core.exceptions" {
        class SorriDenteError {
        + status_code: int
          - __init__(message: str) -> None
        }
        class NotFoundError {
        + status_code: int
        }
        class ValidationError {
        + status_code: int
        }
        class ConflictError {
        + status_code: int
        }
        class AuthenticationError {
        + status_code: int
        }
        class CredentialsNotConfiguredError {
        + status_code: int
        }
        class LLMError {
        + status_code: int
        }
        Exception <|-- SorriDenteError
        SorriDenteError <|-- NotFoundError
        SorriDenteError <|-- ValidationError
        SorriDenteError <|-- ConflictError
        SorriDenteError <|-- AuthenticationError
        SorriDenteError <|-- CredentialsNotConfiguredError
        SorriDenteError <|-- LLMError
    }
}

package "domain" {
    package "domain.services.interfaces" {
        interface IService <<interface>> {
          + name() -> str
        }
        interface IPatientService <<interface>> {
          + create() -> Patient
          + update(patient_id: str) -> Patient
          + delete(patient_id: str) -> bool
          + get(patient_id: str) -> Patient
          + list_all(search: str) -> list[Patient]
          + get_or_create_by_channel(channel: str, external_id: str, name: str) -> Patient
        }
        interface IDentistService <<interface>> {
          + create() -> Dentist
          + update(dentist_id: str) -> Dentist
          + delete(dentist_id: str) -> bool
          + get(dentist_id: str) -> Dentist
          + list_all(only_active: bool) -> list[Dentist]
        }
        interface IProcedureService <<interface>> {
          + create() -> Procedure
          + update(procedure_id: str) -> Procedure
          + delete(procedure_id: str) -> bool
          + list_all(only_active: bool) -> list[Procedure]
        }
        interface ISchedulingService <<interface>> {
          + available_slots(day: date, dentist_id: str, duration_minutes: int) -> list[dict[str, Any]]
          + is_free(dentist_id: str, start: datetime, end: datetime, ignore_id: str) -> bool
          + next_emergency_slot(reference: Optional[datetime]) -> dict[str, Any]
        }
        interface IAppointmentService <<interface>> {
          + schedule(patient_id: str, start: datetime, dentist_id: str, procedure_id: str, notes: str, origin: str, allow_overbook: bool, priority: str) -> Appointment
          + schedule_emergency(patient_id: str, reason: str, origin: str, start: Optional[datetime]) -> Appointment
          + reschedule(appointment_id: str, start: datetime) -> Appointment
          + cancel(appointment_id: str, reason: str) -> Appointment
          + set_status(appointment_id: str, status: str) -> Appointment
          + get(appointment_id: str) -> Appointment
          + list_all() -> list[Appointment]
          + agenda(start: date, end: date) -> list[Appointment]
          + due_reminders(window_hours: int) -> list[Appointment]
          + mark_reminder_sent(appointment_id: str) -> Appointment
        }
        interface IConversationService <<interface>> {
          + get_or_create(channel: str, external_id: str, display_name: str) -> Conversation
          + append(conversation_id: str, author: str, content: str) -> ChatMessage
          + history(conversation_id: str, limit: int) -> list[ChatMessage]
          + list_all(limit: int) -> list[Conversation]
          + mark_read(conversation_id: str) -> Conversation
          + set_handoff(conversation_id: str, handoff: bool) -> Conversation
          + get(conversation_id: str) -> Conversation
          + link_patient(conversation_id: str, patient_id: str) -> Conversation
          + mark_handoff_notice(conversation_id: str) -> Conversation
          + close(conversation_id: str, reason: str) -> Conversation
          + reopen(conversation_id: str) -> Conversation
          + idle_conversations(minutes: int) -> list[Conversation]
        }
        interface INotificationService <<interface>> {
          + notify(title: str, message: str, level: str) -> Notification
          + list_all(only_unread: bool, limit: int) -> list[Notification]
          + mark_read(notification_id: str) -> Notification
          + mark_all_read() -> int
        }
        interface IFAQService <<interface>> {
          + create(question: str, answer: str, tags: Optional[list[str]]) -> FAQ
          + update(faq_id: str) -> FAQ
          + delete(faq_id: str) -> bool
          + list_all() -> list[FAQ]
          + search(term: str, limit: int) -> list[FAQ]
        }
        interface ISettingsService <<interface>> {
          + get() -> ClinicSettings
          + update() -> ClinicSettings
        }
        interface IAuthService <<interface>> {
          + authenticate(username: str, password: str) -> tuple[User, str]
          + register(username: str, password: str, role: str, display_name: str) -> User
          + resolve_token(token: str) -> User
          + list_users() -> list[User]
        }
        interface IAnalyticsService <<interface>> {
          + dashboard() -> dict[str, Any]
        }
        IService <|-- IPatientService
        IService <|-- IDentistService
        IService <|-- IProcedureService
        IService <|-- ISchedulingService
        IService <|-- IAppointmentService
        IService <|-- IConversationService
        IService <|-- INotificationService
        IService <|-- IFAQService
        IService <|-- ISettingsService
        IService <|-- IAuthService
        IService <|-- IAnalyticsService
    }

    package "domain.services (implementações)" {
        class PatientService {
          - __init__(patients: PatientRepository, notifications: 'NotificationService') -> None
          + create() -> Patient
          + update(patient_id: str) -> Patient
          + delete(patient_id: str) -> bool
          + get(patient_id: str) -> Patient
          + list_all(search: str) -> list[Patient]
          + get_or_create_by_channel(channel: str, external_id: str, name: str) -> Patient
        }
        class DentistService {
          - __init__(dentists: DentistRepository) -> None
          + create() -> Dentist
          + update(dentist_id: str) -> Dentist
          + delete(dentist_id: str) -> bool
          + get(dentist_id: str) -> Dentist
          + list_all(only_active: bool) -> list[Dentist]
        }
        class ProcedureService {
          - __init__(procedures: ProcedureRepository) -> None
          + create() -> Procedure
          + update(procedure_id: str) -> Procedure
          + delete(procedure_id: str) -> bool
          + list_all(only_active: bool) -> list[Procedure]
        }
        class SchedulingService {
          - __init__(appointments: AppointmentRepository, dentists: DentistRepository, settings: SettingsRepository) -> None
          - _parse_time(value: str, fallback: time) -> time
          - _windows(dentist: Optional[Dentist], day: date, settings: ClinicSettings) -> list[tuple[time, time]]
          + is_free(dentist_id: str, start: datetime, end: datetime, ignore_id: str) -> bool
          + next_emergency_slot(reference: Optional[datetime]) -> dict[str, Any]
          + available_slots(day: date, dentist_id: str, duration_minutes: int) -> list[dict[str, Any]]
        }
        class AppointmentService {
          - __init__(appointments: AppointmentRepository, patients: PatientRepository, dentists: DentistRepository, procedures: ProcedureRepository, scheduling: SchedulingService, notifications: 'NotificationService', settings: SettingsRepository) -> None
          - _resolve_duration(procedure_id: str) -> tuple[int, str, str]
          + schedule(patient_id: str, start: datetime, dentist_id: str, procedure_id: str, notes: str, origin: str, allow_overbook: bool, priority: str) -> Appointment
          + schedule_emergency(patient_id: str, reason: str, origin: str, start: Optional[datetime]) -> Appointment
          + reschedule(appointment_id: str, start: datetime) -> Appointment
          + cancel(appointment_id: str, reason: str) -> Appointment
          + set_status(appointment_id: str, status: str) -> Appointment
          + get(appointment_id: str) -> Appointment
          + list_all() -> list[Appointment]
          + agenda(start: date, end: date) -> list[Appointment]
          + due_reminders(window_hours: int) -> list[Appointment]
          + mark_reminder_sent(appointment_id: str) -> Appointment
        }
        class ConversationService {
          - __init__(conversations: ConversationRepository, messages: MessageRepository, event_bus: IEventBus) -> None
          + get_or_create(channel: str, external_id: str, display_name: str) -> Conversation
          + get(conversation_id: str) -> Conversation
          + append(conversation_id: str, author: str, content: str) -> ChatMessage
          + history(conversation_id: str, limit: int) -> list[ChatMessage]
          + list_all(limit: int) -> list[Conversation]
          + mark_read(conversation_id: str) -> Conversation
          + set_handoff(conversation_id: str, handoff: bool) -> Conversation
          + link_patient(conversation_id: str, patient_id: str) -> Conversation
          + mark_handoff_notice(conversation_id: str) -> Conversation
          + close(conversation_id: str, reason: str) -> Conversation
          + reopen(conversation_id: str) -> Conversation
          + idle_conversations(minutes: int) -> list[Conversation]
        }
        class NotificationService {
          - __init__(notifications: NotificationRepository, event_bus: IEventBus) -> None
          + notify(title: str, message: str, level: str) -> Notification
          + list_all(only_unread: bool, limit: int) -> list[Notification]
          + mark_read(notification_id: str) -> Notification
          + mark_all_read() -> int
        }
        class FAQService {
          - __init__(faqs: FAQRepository) -> None
          + create(question: str, answer: str, tags: Optional[list[str]]) -> FAQ
          + update(faq_id: str) -> FAQ
          + delete(faq_id: str) -> bool
          + list_all() -> list[FAQ]
          + search(term: str, limit: int) -> list[FAQ]
        }
        class SettingsService {
          - __init__(settings: SettingsRepository) -> None
          + get() -> ClinicSettings
          + update() -> ClinicSettings
        }
        class AuthService {
          - __init__(users: UserRepository) -> None
          + hash_password(password: str, salt: str) -> str
          + register(username: str, password: str, role: str, display_name: str) -> User
          + authenticate(username: str, password: str) -> tuple[User, str]
          + resolve_token(token: str) -> User
          + logout(token: str) -> None
          + list_users() -> list[User]
        }
        class AnalyticsService {
          - __init__(appointments: AppointmentRepository, patients: PatientRepository, conversations: ConversationRepository, notifications: NotificationRepository) -> None
          + dashboard() -> dict[str, Any]
        }
        IPatientService <|.. PatientService
        IDentistService <|.. DentistService
        IProcedureService <|.. ProcedureService
        ISchedulingService <|.. SchedulingService
        IAppointmentService <|.. AppointmentService
        IConversationService <|.. ConversationService
        INotificationService <|.. NotificationService
        IFAQService <|.. FAQService
        ISettingsService <|.. SettingsService
        IAuthService <|.. AuthService
        IAnalyticsService <|.. AnalyticsService
    }

    package "domain.repositories" {
        class PatientRepository {
          - __init__(database: IDatabase) -> None
          + find_by_telegram(telegram_id: str) -> Optional[Patient]
          + find_by_phone(phone: str) -> Optional[Patient]
          + find_by_document(document: str) -> Optional[Patient]
          + search(term: str) -> list[Patient]
        }
        class DentistRepository {
          - __init__(database: IDatabase) -> None
          + active() -> list[Dentist]
        }
        class ProcedureRepository {
          - __init__(database: IDatabase) -> None
          + active() -> list[Procedure]
          + find_by_name(name: str) -> Optional[Procedure]
        }
        class AppointmentRepository {
          - __init__(database: IDatabase) -> None
          + by_patient(patient_id: str) -> list[Appointment]
          + by_dentist(dentist_id: str) -> list[Appointment]
          + in_range(start: datetime, end: datetime) -> list[Appointment]
          + upcoming(reference: Optional[datetime]) -> list[Appointment]
        }
        class ConversationRepository {
          - __init__(database: IDatabase) -> None
          + find_by_external(channel: str, external_id: str) -> Optional[Conversation]
          + recent(limit: int) -> list[Conversation]
          + open_conversations() -> list[Conversation]
        }
        class MessageRepository {
          - __init__(database: IDatabase) -> None
          + by_conversation(conversation_id: str, limit: int) -> list[ChatMessage]
        }
        class NotificationRepository {
          - __init__(database: IDatabase) -> None
          + unread() -> list[Notification]
          + recent(limit: int) -> list[Notification]
        }
        class FAQRepository {
          - __init__(database: IDatabase) -> None
          + active() -> list[FAQ]
          + search(term: str, limit: int) -> list[FAQ]
        }
        class KnowledgeRepository {
          - __init__(database: IDatabase) -> None
          + active() -> list[KnowledgeDocument]
        }
        class UserRepository {
          - __init__(database: IDatabase) -> None
          + find_by_username(username: str) -> Optional[User]
        }
        class SettingsRepository {
        + SINGLETON_ID: str
          - __init__(database: IDatabase) -> None
          + current() -> ClinicSettings
        }
    }
}

package "agent" {
    package "agent (núcleo)" {
        class SorriDenteAgent {
          - __init__(llm: ILLMProvider, tools: ToolRegistry, prompt_builder: IPromptBuilder, conversations: IConversationService, catalog: Optional[ModelCatalog], policy: Optional[IContextPolicy], tracker: Optional[TaskTracker], max_iterations: int, history_limit: int, temperature: float) -> None
          + tools() -> ToolRegistry
          + tracker() -> TaskTracker
          + model() -> Model
          + reply(context: AgentContext, user_message: str) -> str
          - _run(context: AgentContext, user_message: str, task: Task) -> str
          - _load_history(conversation_id: str) -> list[PromptMessage]
          - _call_tool(context: AgentContext, task: Task, call: dict[str, Any]) -> Any
          - _parse_arguments(raw: Any) -> dict[str, Any]
        }
        class EchoAgent {
          - __init__(message: Optional[str]) -> None
          + reply(context: AgentContext, user_message: str) -> str
        }
        IAgent <|.. SorriDenteAgent
        IAgent <|.. EchoAgent
    }
    package "agent.base" {
        abstract class BaseTool <<abstract>> {
          + name() -> str
          + description() -> str
          + parameters() -> dict[str, Any]
          + run(context: AgentContext) -> Any
          + execute(context: AgentContext) -> Any
          + parse_datetime(value: str) -> datetime
          + dump(value: Any) -> str
        }
        interface IToolRegistry <<interface>> {
          + register(tool: ITool) -> 'IToolRegistry'
          + unregister(name: str) -> None
          + get(name: str) -> Optional[ITool]
          + schemas() -> list[dict[str, Any]]
          + names() -> list[str]
        }
        class ToolRegistry {
          - __init__(tools: Optional[Iterable[ITool]]) -> None
          + register(tool: ITool) -> 'ToolRegistry'
          + unregister(name: str) -> None
          + get(name: str) -> Optional[ITool]
          + schemas() -> list[dict[str, Any]]
          + names() -> list[str]
          - __len__() -> int
          - __iter__() -> Iterator[ITool]
          - __contains__(name: object) -> bool
        }
        ITool <|-- BaseTool
        IToolRegistry <|.. ToolRegistry
    }
    package "agent.context" {
        enum MessageRole <<enum>> {
          SYSTEM
          USER
          ASSISTANT
          TOOL
        }
        class PromptMessage {
        + role: MessageRole
        + content: str
        + tool_calls: list[dict[str, Any]]
        + tool_call_id: str
        + name: str
          + to_payload() -> dict[str, Any]
          + estimated_tokens() -> int
        }
        interface IContextPolicy <<interface>> {
          + apply(messages: Sequence[PromptMessage], model: Model) -> list[PromptMessage]
        }
        class SlidingWindowPolicy {
          - __init__(max_messages: int) -> None
          + apply(messages: Sequence[PromptMessage], model: Model) -> list[PromptMessage]
        }
        class TokenBudgetPolicy {
          - __init__(usage_ratio: float, min_messages: int) -> None
          + apply(messages: Sequence[PromptMessage], model: Model) -> list[PromptMessage]
        }
        class CompositePolicy {
          - __init__() -> None
          + apply(messages: Sequence[PromptMessage], model: Model) -> list[PromptMessage]
        }
        class ConversationContext {
          - __init__(system_prompt: str, policy: Optional[IContextPolicy]) -> None
          + system(content: str) -> 'ConversationContext'
          + user(content: str) -> 'ConversationContext'
          + assistant(content: str, tool_calls: Optional[list[dict[str, Any]]]) -> 'ConversationContext'
          + tool_result(tool_call_id: str, name: str, content: str) -> 'ConversationContext'
          + extend(messages: Sequence[PromptMessage]) -> 'ConversationContext'
          + render(model: Model) -> list[dict[str, Any]]
          + messages() -> list[PromptMessage]
          + estimated_tokens() -> int
          - __len__() -> int
          - __iter__() -> Iterator[PromptMessage]
        }
        IContextPolicy <|-- SlidingWindowPolicy
        IContextPolicy <|-- TokenBudgetPolicy
        IContextPolicy <|-- CompositePolicy
        ConversationContext *-- "0..*" PromptMessage
        ConversationContext o-- "1" IContextPolicy
    }
    package "agent.task" {
        enum TaskStatus <<enum>> {
          PENDING
          RUNNING
          DONE
          FAILED
          CANCELLED
        }
        enum TaskKind <<enum>> {
          CONVERSATION_TURN
          TOOL_CALL
          INFERENCE
        }
        class SubTask {
        + name: str
        + kind: TaskKind
        + status: TaskStatus
        + arguments: dict[str, Any]
        + result: Any
        + error: str
        + id: str
        + started_at: float
        + finished_at: Optional[float]
          + start() -> 'SubTask'
          + complete(result: Any) -> 'SubTask'
