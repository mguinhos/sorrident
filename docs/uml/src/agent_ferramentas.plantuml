@startuml agent_ferramentas
!include _estilo.puml
left to right direction

package "agent.base" {
  abstract class BaseTool <<abstract>> {
  + name() -> str
  + description() -> str
  + parameters() -> dict[str, Any]
  + run(context: AgentContext) -> Any
  + execute(context: AgentContext) -> Any
  + parse_datetime(value: str) -> datetime
  + dump(value: Any) -> str
  }
  interface IToolRegistry <<interface>> {
  + register(tool: ITool) -> 'IToolRegistry'
  + unregister(name: str) -> None
  + get(name: str) -> Optional[ITool]
  + schemas() -> list[dict[str, Any]]
  + names() -> list[str]
  }
  class ToolRegistry {
  + register(tool: ITool) -> 'ToolRegistry'
  + unregister(name: str) -> None
  + get(name: str) -> Optional[ITool]
  + schemas() -> list[dict[str, Any]]
  + names() -> list[str]
  - __len__() -> int
  - __iter__() -> Iterator[ITool]
  - __contains__(name: object) -> bool
  }
}

package "agent.tools" {
  abstract class PatientAwareTool <<abstract>> {
  + current_patient(context: AgentContext) -> Optional[Patient]
  + bind(context: AgentContext, patient: Patient) -> Patient
  + resolve_patient(context: AgentContext, name: str, phone: str) -> Patient
  + summarize(patient: Patient) -> dict[str, Any]
  }
  class KnowledgeBaseTool {
  + run(context: AgentContext, pergunta: str, limite: int) -> Any
  }
  class ClinicInfoTool {
  + run(context: AgentContext) -> Any
  }
  class CadastrarClienteTool {
  + run(context: AgentContext) -> Any
  }
  class AtualizarInformacoesClienteTool {
  + run(context: AgentContext) -> Any
  }
  class ConsultarCadastroTool {
  + run(context: AgentContext) -> Any
  }
  class ListProceduresTool {
  + run(context: AgentContext) -> Any
  }
  class ListDentistsTool {
  + run(context: AgentContext) -> Any
  }
  class AvailableSlotsTool {
  + run(context: AgentContext, data: str, profissional_id: str, procedimento_id: str, periodo: str) -> Any
  }
  class MarcarAgendamentoTool {
  - _resolve_procedure(name: str) -> str
  + run(context: AgentContext, data_hora: str, procedimento_id: str, procedimento: str, profissional_id: str, nome_paciente: str, telefone: str, observacoes: str) -> Any
  }
  class MyAppointmentsTool {
  + run(context: AgentContext) -> Any
  }
  class CancelAppointmentTool {
  + run(context: AgentContext, agendamento_id: str, motivo: str) -> Any
  }
  class RescheduleAppointmentTool {
  + run(context: AgentContext, agendamento_id: str, nova_data_hora: str) -> Any
  }
  class ConsultarEncaixeUrgenciaTool {
  + run(context: AgentContext) -> Any
  }
  class AgendarEncaixeUrgenciaTool {
  + run(context: AgentContext, motivo: str, data_hora: str, nome_paciente: str, telefone: str) -> Any
  }
  class HumanHandoffTool {
  + run(context: AgentContext, motivo: str, urgente: bool, assumir_conversa: bool) -> Any
  }
  class EncerrarAtendimentoTool {
  + run(context: AgentContext, resumo: str) -> Any
  }
  class ExportarConversaTool {
  + run(context: AgentContext, formato: str) -> Any
  }
}

package "contexto" <<Frame>> {
  class IAppointmentService
  class IExportService
  class IKnowledgeService
  class IPatientService
  class ISchedulingService
  class ISettingsService
  class ITool
  class SorriDenteAgent
}

AvailableSlotsTool ..> ISchedulingService
BaseTool <|-- AvailableSlotsTool
BaseTool <|-- CancelAppointmentTool
BaseTool <|-- ClinicInfoTool
BaseTool <|-- ConsultarEncaixeUrgenciaTool
BaseTool <|-- EncerrarAtendimentoTool
BaseTool <|-- ExportarConversaTool
BaseTool <|-- HumanHandoffTool
BaseTool <|-- KnowledgeBaseTool
BaseTool <|-- ListDentistsTool
BaseTool <|-- ListProceduresTool
BaseTool <|-- PatientAwareTool
BaseTool <|-- RescheduleAppointmentTool
CadastrarClienteTool ..> IPatientService
ClinicInfoTool ..> ISettingsService
ExportarConversaTool ..> IExportService
ITool <|.. BaseTool
IToolRegistry <|.. ToolRegistry
KnowledgeBaseTool ..> IKnowledgeService
MarcarAgendamentoTool ..> IAppointmentService
PatientAwareTool <|-- AgendarEncaixeUrgenciaTool
PatientAwareTool <|-- AtualizarInformacoesClienteTool
PatientAwareTool <|-- CadastrarClienteTool
PatientAwareTool <|-- ConsultarCadastroTool
PatientAwareTool <|-- MarcarAgendamentoTool
PatientAwareTool <|-- MyAppointmentsTool
SorriDenteAgent o-- "1" ToolRegistry
ToolRegistry o-- "0..*" ITool
@enduml
