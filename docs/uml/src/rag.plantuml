@startuml rag
!include _estilo.puml
left to right direction

package "core" {
  package "domain.repositories" {
    class KnowledgeRepository
    class FAQRepository
    class ProcedureRepository
    class DentistRepository
    class SettingsRepository
  }
}

package "rag" {
  package "rag.documents" {
    class Chunk {
    + id: str
    + document_id: str
    + title: str
    + content: str
    + source: str
    + position: int
    + metadata: dict[str, Any]
      + searchable_text() -> str
      + to_dict() -> dict[str, Any]
    }
    class ScoredChunk {
    + chunk: Chunk
    + score: float
      + to_dict() -> dict[str, Any]
    }
    class Vector {
    + values: dict[str, float]
    + norm: float
      + from_weights(weights: dict[str, float]) -> 'Vector'
      + cosine(other: 'Vector') -> float
    }
  }
  package "rag.interfaces" {
    interface IChunker <<interface>> {
      + split(document: KnowledgeDocument) -> list[Chunk]
    }
    interface IEmbedder <<interface>> {
      + fit(chunks: Sequence[Chunk]) -> None
      + embed(text: str) -> Vector
      + is_fitted() -> bool
    }
    interface IVectorStore <<interface>> {
      + index(entries: Iterable[tuple[Chunk, Vector]]) -> None
      + clear() -> None
      + search(query: Vector, limit: int) -> list[ScoredChunk]
      + chunks() -> list[Chunk]
      - __len__() -> int
    }
    interface IRetriever <<interface>> {
      + retrieve(query: str, limit: int) -> list[ScoredChunk]
      + reindex(documents: Sequence[KnowledgeDocument]) -> int
    }
    interface IKnowledgeService <<interface>> {
      + create(title: str, content: str, tags: Optional[list[str]]) -> KnowledgeDocument
      + update(document_id: str) -> KnowledgeDocument
      + delete(document_id: str) -> bool
      + list_all() -> list[KnowledgeDocument]
      + reindex() -> int
      + search(question: str, limit: int) -> list[ScoredChunk]
      + answer_context(question: str, limit: int) -> dict[str, Any]
    }
  }
  class ParagraphChunker {
    + split(document: KnowledgeDocument) -> list[Chunk]
    - _explode(paragraph: str) -> list[str]
  }
  class WholeDocumentChunker {
    + split(document: KnowledgeDocument) -> list[Chunk]
  }
  class TfIdfEmbedder {
    + is_fitted() -> bool
    + vocabulary_size() -> int
    - _terms(text: str) -> list[str]
    + fit(chunks: Sequence[Chunk]) -> None
    + embed(text: str) -> Vector
  }
  class InMemoryVectorStore {
    + index(entries: Iterable[tuple[Chunk, Vector]]) -> None
    + clear() -> None
    + search(query: Vector, limit: int) -> list[ScoredChunk]
    + chunks() -> list[Chunk]
    - __len__() -> int
  }
  abstract class BaseRetriever <<abstract>> {
    - _explode(documents: Sequence[KnowledgeDocument]) -> list[Chunk]
  }
  class VectorRetriever {
    + reindex(documents: Sequence[KnowledgeDocument]) -> int
    + retrieve(query: str, limit: int) -> list[ScoredChunk]
  }
  class BM25Retriever {
    + reindex(documents: Sequence[KnowledgeDocument]) -> int
    + retrieve(query: str, limit: int) -> list[ScoredChunk]
  }
  class HybridRetriever {
    + reindex(documents: Sequence[KnowledgeDocument]) -> int
    + retrieve(query: str, limit: int) -> list[ScoredChunk]
  }
  class KnowledgeBaseService {
    + indexed_chunks() -> int
    + create(title: str, content: str, tags: Optional[list[str]]) -> KnowledgeDocument
    + update(document_id: str) -> KnowledgeDocument
    + delete(document_id: str) -> bool
    + list_all() -> list[KnowledgeDocument]
    + sources() -> list[KnowledgeDocument]
    + reindex() -> int
    + search(question: str, limit: int) -> list[ScoredChunk]
    + answer_context(question: str, limit: int) -> dict[str, Any]
  }

  IChunker <|.. ParagraphChunker
  IChunker <|.. WholeDocumentChunker
  IEmbedder <|.. TfIdfEmbedder
  IVectorStore <|.. InMemoryVectorStore
  IRetriever <|.. BaseRetriever
  BaseRetriever <|-- VectorRetriever
  BaseRetriever <|-- BM25Retriever
  IRetriever <|.. HybridRetriever
  IKnowledgeService <|.. KnowledgeBaseService
  HybridRetriever o-- "0..*" IRetriever
  VectorRetriever o-- "1" IChunker
  VectorRetriever o-- "1" IEmbedder
  VectorRetriever o-- "1" IVectorStore
  VectorRetriever ..> Chunk
  BM25Retriever o-- IChunker
  KnowledgeBaseService o-- IRetriever
  KnowledgeBaseService --> KnowledgeRepository
  KnowledgeBaseService --> FAQRepository
  KnowledgeBaseService --> ProcedureRepository
  KnowledgeBaseService --> DentistRepository
  KnowledgeBaseService --> SettingsRepository
}
@enduml
